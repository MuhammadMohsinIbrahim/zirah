# Set these in your environment; Zirah does not read a .env file. Every variable is optional:
# Zirah works fully offline with `--llm none`.

# LLM judge (D1–D3 semantic checks): none (default), ollama[:model], openai[:model] or
# anthropic[:model], e.g. ollama:llama3.1:8b. Also settable per run with `zirah scan --llm ...`.
ZIRAH_LLM=none

# Ollama base URL, used when ZIRAH_LLM=ollama
OLLAMA_HOST=http://localhost:11434

# API keys, used only when the matching provider is selected. Read from the environment only,
# sent only to that provider, never logged or written to reports.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
