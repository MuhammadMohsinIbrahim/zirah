# Copy to .env and fill in only what you use. Every variable is optional:
# Zirah works fully offline with `--llm none`.

# LLM judge (D1–D3 semantic checks): none (default) or ollama[:model], e.g. ollama:llama3.1:8b.
# Also settable per run with `zirah scan --llm ...`. openai and anthropic arrive in 0.1.19.
ZIRAH_LLM=none

# Ollama base URL, used when ZIRAH_LLM=ollama
OLLAMA_HOST=http://localhost:11434

# API keys, used only when the matching provider is selected
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
